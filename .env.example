# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Port where Express server runs (defaults to 3000)
PORT=3000

# Optional Payment Gateway credentials (handled via server-side proxy)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional Live Domain Registrar API credentials (handled via server-side proxy)
REGISTRAR_API_KEY=""
REGISTRAR_API_SECRET=""
